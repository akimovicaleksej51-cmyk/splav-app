{
  "appId": "com.splav.mobile",
  "appName": "Сплав",
  "webDir": "www",
  "backgroundColor": "#060608",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#060608",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
